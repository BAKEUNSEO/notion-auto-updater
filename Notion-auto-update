# 🐍 update_notion.py
import requests
from datetime import datetime
import os

NOTION_API_TOKEN = os.getenv("NOTION_API_TOKEN")
DATABASE_ID = os.getenv("DATABASE_ID")

HEADERS = {
    "Authorization": f"Bearer {NOTION_API_TOKEN}",
    "Notion-Version": "2022-06-28",
    "Content-Type": "application/json"
}

# 요일 매핑
DAY_MAPPING = {
    "Monday": "월요일",
    "Tuesday": "화요일",
    "Wednesday": "수요일",
    "Thursday": "목요일",
    "Friday": "금요일"
}

def get_database_items():
    url = f"https://api.notion.com/v1/databases/{DATABASE_ID}/query"
    response = requests.post(url, headers=HEADERS)
    return response.json()

def get_day_of_week_korean(date_str):
    date_obj = datetime.fromisoformat(date_str)
    eng_day = date_obj.strftime('%A')
    return DAY_MAPPING.get(eng_day, None)

def update_page(page_id, updates):
    url = f"https://api.notion.com/v1/pages/{page_id}"
    data = {"properties": updates}
    response = requests.patch(url, headers=HEADERS, json=data)
    return response.status_code == 200

def automate_updates():
    data = get_database_items()
    for item in data.get("results", []):
        page_id = item["id"]
        props = item["properties"]
        updates = {}

        # 제목 자동 업데이트
        title = props.get("상담", {}).get("title", [])
        client = props.get("내담자", {}).get("rich_text", [])
        if not title and client:
            client_name = client[0]["plain_text"]
            updates["상담"] = {
                "title": [{"text": {"content": client_name}}]
            }
            print(f"✍️ 제목 업데이트 예정: {client_name}")

        # 요일 자동 업데이트
        date_info = props.get("날짜", {}).get("date")
        if date_info and date_info.get("start"):
            date_str = date_info["start"]
            day_kr = get_day_of_week_korean(date_str)
            current_day = props.get("요일", {}).get("select", {}).get("name", "")
            if day_kr and current_day != day_kr:
                updates["요일"] = {"select": {"name": day_kr}}
                print(f"📅 요일 업데이트 예정: {day_kr}")
            elif not day_kr:
                print(f"⛔️ 주말 날짜({date_str}), 요일 생략")

        # 실제 업데이트
        if updates:
            success = update_page(page_id, updates)
            print(f"✅ 업데이트 완료: {page_id}" if success else f"❌ 실패: {page_id}")
        else:
            print("🔁 변경 사항 없음")

if __name__ == "__main__":
    automate_updates()

# 🛠️ .github/workflows/run-notion.yml
# GitHub Actions 워크플로우 (5분마다 실행)

name: Update Notion Title and Day

on:
  schedule:
    - cron: '*/5 * * * *'
  workflow_dispatch:

jobs:
  run-script:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v3

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      - name: Install dependencies
        run: pip install requests

      - name: Run Notion auto-update script
        env:
          NOTION_API_TOKEN: ${{ secrets.NOTION_API_TOKEN }}
          DATABASE_ID: ${{ secrets.DATABASE_ID }}
        run: python update_notion.py
